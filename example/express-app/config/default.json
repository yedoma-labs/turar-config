{
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "trustProxy": false
  },
  "cors": {
    "origins": ["http://localhost:3000"],
    "credentials": true
  },
  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "express_app",
    "user": "postgres",
    "pool": {
      "min": 2,
      "max": 10
    },
    "ssl": false
  },
  "redis": {
    "enabled": false,
    "host": "localhost",
    "port": 6379,
    "ttl": 3600
  },
  "session": {
    "name": "sessionId",
    "maxAge": 86400000
  },
  "logging": {
    "level": "info",
    "format": "combined"
  },
  "rateLimit": {
    "windowMs": 900000,
    "max": 100
  }
}
